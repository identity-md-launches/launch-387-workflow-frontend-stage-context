+    // Local fee accounting helpers. Growth uses Q128 fixed point and rounds down. Any
+    // indivisible remainder stays in currency totals for the final withdrawal/cancellation.
+    function _distributeFees(OrderInfo storage info, uint256 amount0, uint256 amount1) private {
+        if (info.liquidityTotal == 0) return;
+        info.feeGrowth0X128 += FullMath.mulDiv(amount0, 1 << 128, info.liquidityTotal);
+        info.feeGrowth1X128 += FullMath.mulDiv(amount1, 1 << 128, info.liquidityTotal);
+    }
+
+    function _accrueFees(OrderInfo storage info, uint256 amount0, uint256 amount1) private {
+        info.currency0Total += amount0;
+        info.currency1Total += amount1;
+        _distributeFees(info, amount0, amount1);
+    }
+
+    function _checkpointOwner(OrderInfo storage info, address owner) private {
+        CheckpointCurrencies storage checkpoint = info.checkpoints[owner];
+        CheckpointCurrencies storage credit = info.feeCredits[owner];
+        uint128 liquidity = info.liquidity[owner];
+        credit.amountCurrency0 += FullMath.mulDiv(info.feeGrowth0X128 - checkpoint.amountCurrency0, liquidity, 1 << 128);
+        credit.amountCurrency1 += FullMath.mulDiv(info.feeGrowth1X128 - checkpoint.amountCurrency1, liquidity, 1 << 128);
+        checkpoint.amountCurrency0 = info.feeGrowth0X128;
+        checkpoint.amountCurrency1 = info.feeGrowth1X128;
     }
 
